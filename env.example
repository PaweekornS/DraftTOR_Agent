# Dual-mode engine: Local CPU dev uses OpenRouter, On-premise uses vLLM
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxx"
LLM_MODEL_NAME="qwen/qwen-2.5-7b-instruct"    # Or on-premise local model tag
LLM_TEMPERATURE=0.2

OUTPUT_DIR="/app/storage/outputs"
TEMPLATE_DIR="/app/templates"
